# Frontend API base URL (used when replacing mock services with a backend)
VITE_API_BASE_URL=http://localhost:3000/api

# Backend only. Keep these values out of VITE_ variables and source control.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/insighthub
INSIGHTHUB_WORKSPACE_ID=demo

# Use "ollama" for local embeddings (no API key or usage charges) or "openai".
EMBEDDING_PROVIDER=openai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Required only when EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
